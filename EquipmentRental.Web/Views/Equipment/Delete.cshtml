@model EquipmentRental.Data.Models.EquipmentItem
@{
    ViewData["Title"] = "Изтриване на оборудване";
}

<section class="content-section">
    <section class="form-section">
        <h1 class="text-danger"><i class="bi bi-trash"></i> Изтриване на оборудване</h1>
        <p>Сигурни ли сте, че искате да изтриете следното оборудване?</p>

        <div class="card delete-card">
            <div class="card-body">
                <h4>@Model.Name</h4>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p>@Model.Description</p>
                }
                <p><strong>Количество:</strong> @Model.AvailableQuantity бр.</p>
                <p><strong>Състояние:</strong> @Model.Condition</p>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Да, изтрий
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x"></i> Отказ
            </a>
        </form>
    </section>
</section>
