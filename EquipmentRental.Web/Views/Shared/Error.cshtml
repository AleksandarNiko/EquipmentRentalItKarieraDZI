@model EquipmentRental.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<main>
    <h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Възникна грешка</h1>
    <p>Съжаляваме, нещо се обърка.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> @Model.RequestId</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-house"></i> Към началото
    </a>
</main>
