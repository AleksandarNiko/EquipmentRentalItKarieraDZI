@model EquipmentRental.Web.Models.EquipmentFormViewModel
@{
    ViewData["Title"] = "Добави оборудване";
}

<section class="content-section">
    <section class="form-section">
        <h1><i class="bi bi-plus-circle"></i> Добави оборудване</h1>

        <form asp-action="Create" method="post" class="equipment-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Въведете име на оборудването" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Кратко описание (до 255 символа)"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AvailableQuantity" class="form-label"></label>
                <input asp-for="AvailableQuantity" type="number" class="form-control" min="0" />
                <span asp-validation-for="AvailableQuantity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control"
                       placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Condition" class="form-label"></label>
                <select asp-for="Condition" class="form-select">
                    <option value="New">Ново</option>
                    <option value="Used">Използвано</option>
                    <option value="NeedsRepair">За ремонт</option>
                </select>
                <span asp-validation-for="Condition" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-lg"></i> Запази
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x"></i> Отказ
                </a>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
