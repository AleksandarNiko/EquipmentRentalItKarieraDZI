@model EquipmentRental.Web.Models.UserListItemViewModel
@{
    ViewData["Title"] = "Изтриване на потребител";
}

<section class="content-section">
    <section class="form-section">
        <h1 class="text-danger"><i class="bi bi-person-x"></i> Изтриване на потребител</h1>
        <p>Сигурни ли сте, че искате да изтриете следния потребител?</p>

        <div class="card delete-card">
            <div class="card-body">
                <p><strong>Потребителско име:</strong> @Model.UserName</p>
                <p><strong>Имейл:</strong> @Model.Email</p>
                @if (!string.IsNullOrWhiteSpace(Model.FirstName) || !string.IsNullOrWhiteSpace(Model.LastName))
                {
                    <p><strong>Имена:</strong> @Model.FirstName @Model.LastName</p>
                }
                <p><strong>Роля:</strong> @Model.Role</p>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" name="id" value="@Model.Id" />
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Да, изтрий
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x"></i> Отказ
            </a>
        </form>
    </section>
</section>
